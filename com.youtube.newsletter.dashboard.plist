<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.youtube.newsletter</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/dajiu/project_tutor/youtube-to-ebook/run_newsletter.sh</string>
    </array>

    <!-- 唤醒电脑执行任务 -->
    <key>WakeFromSleep</key>
    <true/>

    <!-- Run every day at 7:00 AM -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/dajiu/project_tutor/youtube-to-ebook/logs/launchd.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/dajiu/project_tutor/youtube-to-ebook/logs/launchd_error.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/dajiu/project_tutor/youtube-to-ebook</string>
</dict>
</plist>