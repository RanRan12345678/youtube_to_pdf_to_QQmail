# ============================================
# YouTube to Ebook - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual API keys
# The .env file is listed in .gitignore and will NOT be uploaded to GitHub

# ============================================
# YouTube Data API Key (Required)
# ============================================
# Get it at: https://console.cloud.google.com/apis/credentials
# Steps:
# 1. Go to Google Cloud Console
# 2. Create a new project
# 3. Enable "YouTube Data API v3"
# 4. Create credentials → API Key
# 5. Copy the API key here
YOUTUBE_API_KEY=your_youtube_api_key_here

# ============================================
# Anthropic API Key (Required)
# ============================================
# Get it at: https://console.anthropic.com/
# This is used to generate articles with Claude AI
# Pricing: https://www.anthropic.com/pricing
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================
# Gmail Credentials (Required for email delivery)
# ============================================
# Create an App Password at: https://myaccount.google.com/apppasswords
# Note: You need to enable 2-Factor Authentication first
#登录网页版：mail.qq.com
#右上角 → 设置 → 账户
#下拉找到：POP3/IMAP/SMTP/Exchange/CardDAV/CalDAV 服务
#点击 开启（IMAP/SMTP）→ 按提示完成短信 / 微信验证
#验证通过 → 点击 生成授权码
#复制 16 位授权码（只显示一次，务必保存）
GMAIL_ADDRESS=your_email@qq.com
GMAIL_APP_PASSWORD=your_auth_code


# ============================================
# PushPlus Token (Optional - for WeChat notifications)
# ============================================
# Get it at: http://www.pushplus.plus/
# This allows you to receive notifications on WeChat
# Leave empty if you don't need WeChat notifications
PUSHPLUS_TOKEN=your_pushplus_token_here

# ============================================
# Proxy Settings (Optional)
# ============================================
# If you need to use a proxy to access YouTube or other services
# Format: http://proxy_host:port or https://proxy_host:port
# Leave empty if you don't need a proxy
HTTP_PROXY=
HTTPS_PROXY=

# ============================================
# Additional Notes
# ============================================
# - Never share your .env file or commit it to Git
# - Keep your API keys secure and rotate them regularly
# - Some APIs have free tier limits, monitor your usage
# - For GitHub Actions, configure these as Repository Secrets
